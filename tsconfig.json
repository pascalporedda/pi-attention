{
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"skipLibCheck": true,
		"noEmit": true,
		"allowJs": true,
		"checkJs": true,
		"types": ["node"]
	},
	"include": ["src/**/*.ts", "src/**/*.mjs", "test/**/*.ts", "vite.config.ts"]
}
