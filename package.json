{
	"name": "pi-attention",
	"version": "0.1.0",
	"description": "Sound and macOS notifications when a Pi agent asks a question in an unfocused tmux window.",
	"keywords": [
		"alacritty",
		"notifications",
		"pi",
		"pi-package",
		"tmux"
	],
	"license": "MIT",
	"author": "Pascal Poredda",
	"repository": {
		"type": "git",
		"url": "https://github.com/pascalporedda/pi-attention.git"
	},
	"files": [
		"src",
		"README.md",
		"LICENSE"
	],
	"type": "module",
	"scripts": {
		"check": "vp check",
		"format": "vp fmt",
		"format:check": "vp fmt --check",
		"lint": "vp lint .",
		"lint:fix": "vp check --fix",
		"typecheck": "vp exec tsc --noEmit",
		"test": "vp test run"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "0.99.1",
		"@types/node": "^22.0.0",
		"typescript": "^5.6.0",
		"vite-plus": "catalog:"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "12.8.1",
			"onFail": "download"
		}
	},
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	}
}
